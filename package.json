    "@vitejs/plugin-react": "4.7.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.11.5",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "3.2.7"
